{
  "name": "webext-user-scripts",
  "version": "1.0.0",
  "description": "Typed helpers for the Chrome userScripts API — register, update, and manage user scripts in Manifest V3 extensions. Part of @zovo/webext.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theluckystrike/webext-user-scripts.git"
  },
  "homepage": "https://github.com/theluckystrike/webext-user-scripts#readme",
  "bugs": {
    "url": "https://github.com/theluckystrike/webext-user-scripts/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "chrome-extension",
    "user-scripts",
    "typescript",
    "manifest-v3",
    "chrome",
    "browser-extension",
    "webext",
    "developer-tools"
  ],
  "author": "theluckystrike",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.260",
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
